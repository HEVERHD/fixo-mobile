# Copiar a .env.local y completar con los valores del proyecto de Supabase
# (Supabase Dashboard → Project Settings → API). No commitear .env.local.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base of the link printed in each equipment QR (<base>/q/FX-…). Optional, defaults
# to https://fixo.co. Never change it once stickers are printed.
# EXPO_PUBLIC_ASSET_LINK_BASE=https://fixo.co
